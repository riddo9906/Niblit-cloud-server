GGUF_MODELS_JSON={"qwen2.5-0.5b":"./models/qwen2.5-0.5b-instruct-q4_k_m.gguf"}
DEFAULT_MODEL_ID=qwen2.5-0.5b
COMPAT_PREFIXES=hf,local,kimi,claude
N_CTX=4096
N_THREADS=4

# ── Niblit integration ────────────────────────────────────────────────────────
# Point Niblit's local_brain HTTP backend at this server by setting:
#
#   NIBLIT_LLAMA_SERVER_URL=https://<your-cloud-server-url>
#   NIBLIT_GGUF_BACKEND=http
#
# The server handles "model": "local" (sent automatically by QwenLocalBrain)
# and also responds to the probe endpoints that Niblit uses to detect the
# server: GET /health, GET /v1/models, GET /props.
