GGUF_MODELS_JSON={"qwen2.5-0.5b":"./models/qwen2.5-0.5b-instruct-q4_k_m.gguf"}
DEFAULT_MODEL_ID=qwen2.5-0.5b
COMPAT_PREFIXES=hf,local,kimi,claude
N_CTX=4096
N_THREADS=4

# ── Niblit integration ────────────────────────────────────────────────────────
# Point Niblit's local_brain HTTP backend at this server by setting:
#
#   NIBLIT_LLAMA_SERVER_URL=https://<your-cloud-server-url>
#   NIBLIT_GGUF_BACKEND=http
#
# The server handles "model": "local" (sent automatically by QwenLocalBrain)
# and also responds to the probe endpoints that Niblit uses to detect the
# server: GET /health, GET /v1/models, GET /props.

# ── Cognitive Cloud Runtime (Phase Ω.7) ──────────────────────────────────────

# ── Model Orchestrator ────────────────────────────────────────────────────────
# NIBLIT_MO_ENABLED=1        # Set to "0" to disable orchestration
# NIBLIT_MO_LATENCY_WEIGHT=0.3  # Weight of latency penalty in routing score
# NIBLIT_MO_TRUST_WEIGHT=0.7    # Weight of trust score in routing score
# NIBLIT_CLOUD_LLM_URL=        # Remote Ollama/LMStudio/custom cloud LLM base URL

# ── Constitutional Governance ─────────────────────────────────────────────────
# NIBLIT_CG_ENABLED=1        # Set to "0" to disable constitutional governance
# NIBLIT_CG_STRICT=1         # Set to "0" for permissive (log-only) mode
# NIBLIT_CG_MAX_TOKENS=8192  # Hard token ceiling (requests above this are blocked)
# NIBLIT_CG_MAX_RECURSION=16 # Max recursion depth before blocking

# ── Temporal Coherence ────────────────────────────────────────────────────────
# NIBLIT_TS_ENABLED=1         # Set to "0" to disable temporal sync
# NIBLIT_TS_EMA_ALPHA=0.1     # EMA smoothing factor for coherence tracking

# ── Reflection Engine ─────────────────────────────────────────────────────────
# NIBLIT_RE_ENABLED=1          # Set to "0" to disable reflection
# NIBLIT_RE_CADENCE=50         # Number of requests between auto-reflections
# NIBLIT_CLOUD_REFLECTION_FILE=/tmp/niblit_cloud_reflection.jsonl

# ── Attention Allocator ───────────────────────────────────────────────────────
# NIBLIT_AA_ENABLED=1          # Set to "0" to disable attention economy
# NIBLIT_AA_MAX_QUEUE=64       # Max concurrent active requests
# NIBLIT_AA_OVERLOAD_RATIO=0.85  # Queue fill ratio that triggers overload mode

# ── Trading Cognition Bridge ──────────────────────────────────────────────────
# NIBLIT_TRADING_BRIDGE_ENABLED=1   # Set to "0" to disable trading bridge
# NIBLIT_SIGNAL_FILE=/tmp/niblit_lean_signal.json   # Schema-v2 signal envelope
# NIBLIT_SIGNAL_MAX_AGE=300         # Max signal age in seconds before stale
# NIBLIT_REFLECTION_FILE=/tmp/niblit_trade_reflection.jsonl
# NIBLIT_EPISODES_FILE=/tmp/niblit_market_episodes.jsonl

# ── Node Identity (Cluster/Swarm) ─────────────────────────────────────────────
# NIBLIT_NODE_ID=              # Override auto-generated node ID (optional)
# NIBLIT_NODE_REGION=local     # Geographic region hint
# NIBLIT_NODE_ROLE=inference   # Node role (inference | orchestrator | gateway)

