# tools/runtime_profiles/local-runtime.env
# Portable local runtime profile (desktop/server local execution)

NIBLIT_PROFILE=local-runtime
NIBLIT_APP_NAME=niblit-local-runtime
NIBLIT_HOST=127.0.0.1
NIBLIT_PORT=8000

NIBLIT_UNIX_SOCKET=/tmp/niblit-local.sock
NIBLIT_TCP_ADMIN_HOST=127.0.0.1
NIBLIT_TCP_ADMIN_PORT=0

NIBLIT_RUNTIME_MODE=normal
NIBLIT_RUNTIME_TOPOLOGY=local
NIBLIT_GOVERNANCE_STRICT=1
NIBLIT_GGUF_BACKEND=http
NIBLIT_TUNNEL_PROVIDER=none
NIBLIT_FEDERATION_ENABLED=0

NIBLIT_CLOUD_REFLECTION_FILE=/tmp/niblit_cloud_reflection.jsonl
NIBLIT_CLOUD_EPISODES_FILE=/tmp/niblit_episodes.jsonl
NIBLIT_CLOUD_SIGNAL_FILE=/tmp/niblit_trading_signal.json
