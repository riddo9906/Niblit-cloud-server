# tools/runtime_profiles/termux-local.env
# Niblit Termux local inference runtime profile
# Suitable for: Termux on Android, constrained ARM devices

NIBLIT_PROFILE=termux-local
NIBLIT_APP_NAME=niblit-termux

# Termux-specific
TERMUX_PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
TERMUX_HOME=${HOME:-/data/data/com.termux/files/home}

# Server address — localhost only on device
NIBLIT_HOST=127.0.0.1
NIBLIT_PORT=8000

# IPC / sidecar socket (prefer UNIX socket on Termux)
NIBLIT_UNIX_SOCKET=${TMPDIR:-/tmp}/niblit-termux.sock
NIBLIT_TCP_ADMIN_HOST=127.0.0.1
NIBLIT_TCP_ADMIN_PORT=9009

# Model paths — launcher will resolve the first preferred GGUF in this directory
NIBLIT_MODEL_PATH=${NIBLIT_MODEL_PATH:-$HOME/models}
NIBLIT_GGUF_BACKEND=llama-server
NIBLIT_LLAMA_SERVER_URL=http://127.0.0.1:8000
NIBLIT_LLAMA_SERVER_BIN=${NIBLIT_LLAMA_SERVER_BIN:-$HOME/llama.cpp/build/bin/llama-server}

# Runtime mode — conservative for edge device
NIBLIT_RUNTIME_MODE=cautious
NIBLIT_RUNTIME_TOPOLOGY=edge
NIBLIT_GOVERNANCE_STRICT=1
NIBLIT_AA_ENABLED=1
NIBLIT_AA_MAX_QUEUE=8
NIBLIT_AA_OVERLOAD_RATIO=0.75
NIBLIT_MO_ENABLED=1
NIBLIT_TS_ENABLED=1
NIBLIT_RE_ENABLED=1
NIBLIT_CG_ENABLED=1
NIBLIT_CG_MAX_TOKENS=4096
NIBLIT_CG_MAX_RECURSION=8

# Federation (stub)
NIBLIT_FEDERATION_ENABLED=0

# Tunnel defaults (cloudflared / ngrok preferred on Termux)
NIBLIT_TUNNEL_PROVIDER=${NIBLIT_TUNNEL_PROVIDER:-cloudflared}
NIBLIT_TUNNEL_PORT=8000
NIBLIT_TUNNEL_PUBLIC_URL=${NIBLIT_TUNNEL_PUBLIC_URL:-}

# Resource management
NIBLIT_N_CTX=2048
NIBLIT_N_THREADS=4
NIBLIT_N_GPU_LAYERS=0

# Reflection telemetry
NIBLIT_CLOUD_REFLECTION_FILE=${TMPDIR:-/tmp}/niblit_cloud_reflection.jsonl
NIBLIT_CLOUD_EPISODES_FILE=${TMPDIR:-/tmp}/niblit_episodes.jsonl
NIBLIT_CLOUD_SIGNAL_FILE=${TMPDIR:-/tmp}/niblit_trading_signal.json
