# tools/runtime_profiles/disconnected-runtime.env
# Runtime profile for disconnected/offline deterministic mode

NIBLIT_PROFILE=disconnected-runtime
NIBLIT_APP_NAME=niblit-disconnected-runtime
NIBLIT_HOST=127.0.0.1
NIBLIT_PORT=8000

NIBLIT_UNIX_SOCKET=/tmp/niblit-disconnected.sock
NIBLIT_TCP_ADMIN_HOST=
NIBLIT_TCP_ADMIN_PORT=0

NIBLIT_RUNTIME_MODE=lockdown
NIBLIT_RUNTIME_TOPOLOGY=disconnected
NIBLIT_GOVERNANCE_STRICT=1
NIBLIT_GGUF_BACKEND=stub
NIBLIT_AA_MAX_QUEUE=2
NIBLIT_AA_OVERLOAD_RATIO=0.50
NIBLIT_CG_MAX_TOKENS=1024
NIBLIT_CG_MAX_RECURSION=2
NIBLIT_TUNNEL_PROVIDER=none
NIBLIT_FEDERATION_ENABLED=0

NIBLIT_CLOUD_REFLECTION_FILE=/tmp/niblit_cloud_reflection.jsonl
NIBLIT_CLOUD_EPISODES_FILE=/tmp/niblit_episodes.jsonl
NIBLIT_CLOUD_SIGNAL_FILE=/tmp/niblit_trading_signal.json
