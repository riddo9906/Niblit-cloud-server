# tools/runtime_profiles/cloud-server.env
# Niblit cloud-server (this repo) runtime profile
# Suitable for: Fly.io, Docker, VPS, local Linux server

NIBLIT_PROFILE=cloud-server
NIBLIT_APP_NAME=niblit-cloud-server

# Server address
NIBLIT_HOST=0.0.0.0
NIBLIT_PORT=8000

# IPC / sidecar socket
NIBLIT_UNIX_SOCKET=/tmp/niblit-cloud-server.sock
NIBLIT_TCP_ADMIN_HOST=
NIBLIT_TCP_ADMIN_PORT=0

# Model paths
NIBLIT_MODEL_PATH=${NIBLIT_MODEL_PATH:-}
NIBLIT_GGUF_BACKEND=${NIBLIT_GGUF_BACKEND:-stub}
GGUF_MODELS_JSON={}

# Runtime mode defaults
NIBLIT_RUNTIME_MODE=normal
NIBLIT_RUNTIME_TOPOLOGY=cloud
NIBLIT_GOVERNANCE_STRICT=1
NIBLIT_AA_ENABLED=1
NIBLIT_AA_MAX_QUEUE=64
NIBLIT_AA_OVERLOAD_RATIO=0.85
NIBLIT_MO_ENABLED=1
NIBLIT_TS_ENABLED=1
NIBLIT_RE_ENABLED=1
NIBLIT_CG_ENABLED=1
NIBLIT_CG_MAX_TOKENS=8192
NIBLIT_CG_MAX_RECURSION=16

# Federation (stub)
NIBLIT_FEDERATION_ENABLED=0
NIBLIT_FEDERATION_MAX_PEERS=8
NIBLIT_HEARTBEAT_INTERVAL=30

# Tunnel defaults
NIBLIT_TUNNEL_PROVIDER=none
NIBLIT_TUNNEL_PORT=8000

# Reflection telemetry
NIBLIT_CLOUD_REFLECTION_FILE=/tmp/niblit_cloud_reflection.jsonl
NIBLIT_CLOUD_EPISODES_FILE=/tmp/niblit_episodes.jsonl
NIBLIT_CLOUD_SIGNAL_FILE=/tmp/niblit_trading_signal.json

# Compatibility prefix routes
COMPAT_PREFIXES=hf,local,kimi,claude

# Node identity
NIBLIT_NODE_REGION=${NIBLIT_NODE_REGION:-cloud}
NIBLIT_NODE_ROLE=${NIBLIT_NODE_ROLE:-inference}
