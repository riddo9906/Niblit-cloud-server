# tools/runtime_profiles/niblit.env
# Niblit main-app runtime profile
# Source this file or use profile_loader.sh to activate environment

NIBLIT_PROFILE=niblit
NIBLIT_APP_NAME=niblit

# Server address
NIBLIT_HOST=127.0.0.1
NIBLIT_PORT=5000

# IPC / sidecar socket
NIBLIT_UNIX_SOCKET=/tmp/niblit.sock
NIBLIT_TCP_ADMIN_HOST=127.0.0.1
NIBLIT_TCP_ADMIN_PORT=0

# Model paths — override via env
NIBLIT_MODEL_PATH=${NIBLIT_MODEL_PATH:-}
NIBLIT_GGUF_BACKEND=http
NIBLIT_LLAMA_SERVER_URL=http://127.0.0.1:8000

# Runtime mode defaults (aligned with Ω.7 governance modes)
NIBLIT_RUNTIME_MODE=normal
NIBLIT_RUNTIME_TOPOLOGY=local
NIBLIT_GOVERNANCE_STRICT=1
NIBLIT_AA_ENABLED=1
NIBLIT_MO_ENABLED=1
NIBLIT_TS_ENABLED=1
NIBLIT_RE_ENABLED=1
NIBLIT_CG_ENABLED=1
NIBLIT_N_CTX=16384
NIBLIT_N_BATCH=1024
NIBLIT_N_UBATCH=512

# Federation (stub)
NIBLIT_FEDERATION_ENABLED=0

# Tunnel defaults (Termux / Termux-desktop hybrid)
NIBLIT_TUNNEL_PROVIDER=none
NIBLIT_TUNNEL_PORT=5000

# Reflection telemetry
NIBLIT_CLOUD_REFLECTION_FILE=/tmp/niblit_cloud_reflection.jsonl
NIBLIT_CLOUD_EPISODES_FILE=/tmp/niblit_episodes.jsonl
NIBLIT_CLOUD_SIGNAL_FILE=/tmp/niblit_trading_signal.json
