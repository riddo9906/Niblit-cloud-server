# tools/runtime_profiles/edge-runtime.env
# Portable edge runtime profile (ARM/Termux/constrained host)

NIBLIT_PROFILE=edge-runtime
NIBLIT_APP_NAME=niblit-edge-runtime
NIBLIT_HOST=127.0.0.1
NIBLIT_PORT=8000

NIBLIT_UNIX_SOCKET=${TMPDIR:-/tmp}/niblit-edge.sock
NIBLIT_TCP_ADMIN_HOST=127.0.0.1
NIBLIT_TCP_ADMIN_PORT=9009

NIBLIT_RUNTIME_MODE=cautious
NIBLIT_RUNTIME_TOPOLOGY=edge
NIBLIT_GOVERNANCE_STRICT=1
NIBLIT_N_CTX=4096
NIBLIT_N_BATCH=512
NIBLIT_N_UBATCH=256
NIBLIT_GGUF_BACKEND=llama-server
NIBLIT_AA_MAX_QUEUE=8
NIBLIT_AA_OVERLOAD_RATIO=0.75
NIBLIT_TUNNEL_PROVIDER=${NIBLIT_TUNNEL_PROVIDER:-cloudflared}
NIBLIT_TUNNEL_PORT=8000
NIBLIT_FEDERATION_ENABLED=0

NIBLIT_CLOUD_REFLECTION_FILE=${TMPDIR:-/tmp}/niblit_cloud_reflection.jsonl
NIBLIT_CLOUD_EPISODES_FILE=${TMPDIR:-/tmp}/niblit_episodes.jsonl
NIBLIT_CLOUD_SIGNAL_FILE=${TMPDIR:-/tmp}/niblit_trading_signal.json
