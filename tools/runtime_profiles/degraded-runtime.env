# tools/runtime_profiles/degraded-runtime.env
# Runtime profile for high-pressure / degraded service conditions

NIBLIT_PROFILE=degraded-runtime
NIBLIT_APP_NAME=niblit-degraded-runtime
NIBLIT_HOST=0.0.0.0
NIBLIT_PORT=8000

NIBLIT_UNIX_SOCKET=/tmp/niblit-degraded.sock
NIBLIT_TCP_ADMIN_HOST=
NIBLIT_TCP_ADMIN_PORT=0

NIBLIT_RUNTIME_MODE=survival
NIBLIT_RUNTIME_TOPOLOGY=hybrid
NIBLIT_GOVERNANCE_STRICT=1
NIBLIT_GGUF_BACKEND=stub
NIBLIT_AA_MAX_QUEUE=4
NIBLIT_AA_OVERLOAD_RATIO=0.60
NIBLIT_CG_MAX_TOKENS=2048
NIBLIT_CG_MAX_RECURSION=4
NIBLIT_TUNNEL_PROVIDER=none
NIBLIT_FEDERATION_ENABLED=0

NIBLIT_CLOUD_REFLECTION_FILE=/tmp/niblit_cloud_reflection.jsonl
NIBLIT_CLOUD_EPISODES_FILE=/tmp/niblit_episodes.jsonl
NIBLIT_CLOUD_SIGNAL_FILE=/tmp/niblit_trading_signal.json
